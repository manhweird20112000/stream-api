APP_NAME=api-gateway
APP_PORT=3000
NODE_ENV=development

KAFKA_BROKERS=localhost:9094
KAFKA_CLIENT_ID=api-gateway
KAFKA_GROUP_ID=api-gateway

# Optional database values kept for local/downstream services.
# The API Gateway does not read these after the microservice split.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=stream_service
DB_SYNC=false

JWT_SECRET=change-this-secret-before-deployment
TOKEN_EXPIRATION=1000d
