{
  "info": {
    "_postman_id": "0aa19dd4-07cc-42d8-b77f-5b78606205e1",
    "name": "Auth Service",
    "description": "Postman collection for auth-service. Import the matching local environment, run Register, read the OTP from the email/outbox, run Verify email, then Login/Me/Refresh/Logout. Refresh token is stored by Postman as the HttpOnly `refresh_token` cookie.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register with email/password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('register succeeds', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.email) {",
                  "  pm.environment.set('userEmail', json.data.email);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Creates a pending email/password registration draft and writes an outbox event for email verification. This endpoint does not create a session."
          },
          "response": []
        },
        {
          "name": "Verify email",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('verify succeeds', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.accessToken) {",
                  "  pm.environment.set('accessToken', json.data.accessToken);",
                  "  pm.environment.set('userId', json.data.user.id);",
                  "  pm.environment.set('userEmail', json.data.user.email);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"code\": \"{{verificationCode}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/verify-email",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "verify-email"
              ]
            },
            "description": "Activates the pending email/password account with the OTP from mail/outbox, returns accessToken, and sets HttpOnly `refresh_token` cookie."
          },
          "response": []
        },
        {
          "name": "Login with email/password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('login succeeds', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.accessToken) {",
                  "  pm.environment.set('accessToken', json.data.accessToken);",
                  "  pm.environment.set('userId', json.data.user.id);",
                  "  pm.environment.set('userEmail', json.data.user.email);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Logs in using email/password. Response body contains accessToken; refresh token is set as HttpOnly cookie `refresh_token`."
          },
          "response": []
        },
        {
          "name": "Get current user",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Returns the current authenticated user. Run Verify email or Login first so `accessToken` is set."
          },
          "response": []
        },
        {
          "name": "Refresh session using cookie",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('refresh succeeds', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.accessToken) {",
                  "  pm.environment.set('accessToken', json.data.accessToken);",
                  "  pm.environment.set('userId', json.data.user.id);",
                  "  pm.environment.set('userEmail', json.data.user.email);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "description": "Rotates refresh token using the Postman cookie jar. Run Verify email or Login first so Postman has the HttpOnly `refresh_token` cookie."
          },
          "response": []
        },
        {
          "name": "Refresh session using body token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('refresh succeeds', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.accessToken) {",
                  "  pm.environment.set('accessToken', json.data.accessToken);",
                  "  pm.environment.set('userId', json.data.user.id);",
                  "  pm.environment.set('userEmail', json.data.user.email);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "description": "Alternative refresh path for API/mobile clients. Paste a raw refresh token into the `refreshToken` environment variable."
          },
          "response": []
        },
        {
          "name": "Logout using cookie",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('logout succeeds', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "pm.environment.unset('accessToken');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Revokes the current refresh token using the Postman cookie jar and clears the cookie."
          },
          "response": []
        },
        {
          "name": "Logout using body token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('logout succeeds', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "pm.environment.unset('accessToken');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Alternative logout path for API/mobile clients. Paste a raw refresh token into the `refreshToken` environment variable."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Google OAuth",
      "item": [
        {
          "name": "Start Google OAuth",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/google/start",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "google",
                "start"
              ]
            },
            "description": "Starts backend OAuth redirect. In Postman, keep redirects disabled if you only want to inspect the Google Location header. For real login, open this URL in a browser."
          },
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "response": []
        },
        {
          "name": "Google callback manual debug",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/google/callback?code={{googleCode}}&state={{googleState}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "google",
                "callback"
              ],
              "query": [
                {
                  "key": "code",
                  "value": "{{googleCode}}"
                },
                {
                  "key": "state",
                  "value": "{{googleState}}"
                }
              ]
            },
            "description": "Manual debug endpoint. Normal OAuth callback is browser-driven and requires matching `oauth_state` cookie from Start Google OAuth."
          },
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "response": []
        }
      ]
    }
  ]
}
