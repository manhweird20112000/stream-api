    {
      "name": "Google OAuth",
      "item": [
        {
          "name": "Start Google OAuth",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiV1Url}}/auth/google/start",
              "host": [
                "{{apiV1Url}}"
              ],
              "path": [
                "auth",
                "google",
                "start"
              ]
            },
            "description": "Starts backend OAuth redirect. Keep redirects disabled to inspect Google Location header. For real login, open this URL in a browser."
          },
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "response": []
        },
        {
          "name": "Google callback manual debug",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiV1Url}}/auth/google/callback?code={{googleCode}}&state={{googleState}}",
              "host": [
                "{{apiV1Url}}"
              ],
              "path": [
                "auth",
                "google",
                "callback"
              ],
              "query": [
                {
                  "key": "code",
                  "value": "{{googleCode}}"
                },
                {
                  "key": "state",
                  "value": "{{googleState}}"
                }
              ]
            },
            "description": "Manual debug endpoint. Normal callback requires matching `oauth_state` cookie from Start Google OAuth."
