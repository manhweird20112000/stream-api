{
  "info": {
    "_postman_id": "0aa19dd4-07cc-42d8-b77f-5b78606205e1",
    "name": "Auth Service",
    "description": "Auth-service collection. Flow: Register -> read OTP from email/outbox -> Verify email -> Me/Refresh/Logout. Login works only after email verification. Refresh token is stored by Postman as HttpOnly cookie `refresh_token`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
