    {
      "name": "Auth",
      "item": [
        {
          "name": "Register with email/password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('register succeeds', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "const data = body.data || body;",
                  "if (data && data.email) {",
                  "  pm.environment.set('userEmail', data.email);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{apiV1Url}}/auth/register",
              "host": [
                "{{apiV1Url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Creates or overwrites a pending email registration draft. Does not login. Check `outbox_events` or email delivery for the OTP/link."
          },
          "response": []
        },
        {
          "name": "Verify email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('verify succeeds', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "const data = body.data || body;",
                  "if (data && data.accessToken) {",
                  "  pm.environment.set('accessToken', data.accessToken);",
                  "  pm.environment.set('userId', data.user.id);",
                  "  pm.environment.set('userEmail', data.user.email);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"code\": \"{{verificationCode}}\"\n}"
            },
            "url": {
              "raw": "{{apiV1Url}}/auth/verify-email",
              "host": [
                "{{apiV1Url}}"
              ],
              "path": [
                "auth",
                "verify-email"
              ]
            },
            "description": "Consumes OTP, activates account, returns access token, and sets HttpOnly `refresh_token` cookie."
          },
          "response": []
        },
        {
          "name": "Login with email/password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login succeeds', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "const data = body.data || body;",
                  "if (data && data.accessToken) {",
                  "  pm.environment.set('accessToken', data.accessToken);",
                  "  pm.environment.set('userId', data.user.id);",
                  "  pm.environment.set('userEmail', data.user.email);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{apiV1Url}}/auth/login",
              "host": [
                "{{apiV1Url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Logs in verified email/password account. Sets HttpOnly `refresh_token` cookie."
          },
          "response": []
        },
        {
          "name": "Me",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{apiV1Url}}/auth/me",
              "host": [
                "{{apiV1Url}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Requires Bearer `accessToken` from Verify email, Login, or Refresh."
          },
          "response": []
        },
        {
          "name": "Update me",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('update me succeeds', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "const data = body.data || body;",
                  "if (data && data.displayName) {",
                  "  pm.environment.set('displayName', data.displayName);",
                  "}",
                  "if (data && data.avatarUrl) {",
                  "  pm.environment.set('avatarUrl', data.avatarUrl);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Owner Name\",\n  \"avatarUrl\": \"https://example.com/avatar.png\"\n}"
            },
            "url": {
              "raw": "{{apiV1Url}}/auth/me",
              "host": [
                "{{apiV1Url}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Updates the authenticated user's display name and avatar URL. Send `null` to clear either field."
          },
          "response": []
        },
